QDRANT_API_KEY="Your Qdrant API key here"
QDRANT_CLUSTER_ENDPOINT="Your Qdrant cluster endpoint here"
OPENAI_API_KEY="Your OpenAI API key here"
VOYAGE_API_KEY="Your Voyage API key here"

# Optional. Used for NIH lookups (PubMed via NCBI E-utilities) when answering
# general medical questions. Not required — MedlinePlus and PubMed both work
# without them — but an API key raises the free rate limit from 3 to 10
# requests/sec, and an email is standard NCBI etiquette for identifying your
# tool. See https://support.nlm.nih.gov/kbArticle/?pn=KA-05317
NCBI_API_KEY="Your NCBI API key here (optional)"
NCBI_EMAIL="Your contact email here (optional)"